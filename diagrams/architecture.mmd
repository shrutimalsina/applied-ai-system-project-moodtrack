%% MoodTrack system architecture
flowchart TB
    subgraph PREP["Data and model preparation"]
        direction LR
        RAW["Spotify Tracks dataset"] --> CLEAN["prepare_data.py<br/>clean tracks and label moods"]
        CLEAN --> CAT[("tracks_clean.csv<br/>80,200 songs")]
        EMO["Emotions dataset for NLP"] --> TRAIN["emotion_model.py<br/>train baseline model"]
        TRAIN --> BASE[("emotion_model.joblib")]
    end

    HF[("Downloaded DistilRoBERTa model")]
    ENTRY(["Journal entry"])

    subgraph APP["MoodTrack · src/moodtrack.py"]
        VALID{"Entry valid?<br/>Long entries are trimmed"}
        INVALID(["Ask for more text"])
        SAFETY{"Crisis phrase matched?"}
        HELP(["Show support message<br/>and stop"])
        READER["Read emotion scores<br/>use baseline if main model fails to load"]
        MOOD["Map feelings to the mood grid<br/>flag low confidence or negated positives"]
        MODE{"Interactive?"}
        HUMAN["User confirms or corrects mood<br/>and chooses a goal"]
        SCRIPT["Use supplied mood and goal if given<br/>otherwise use model guess and suggested goal"]

        VALID -- no --> INVALID
        VALID -- yes --> SAFETY
        SAFETY -- yes --> HELP
        SAFETY -- no --> READER
        READER --> MOOD --> MODE
        MODE -- yes --> HUMAN
        MODE -- no --> SCRIPT
    end

    subgraph AGENT["Playlist agent · src/agent.py"]
        PLAN["Plan five points from starting mood to goal"]
        PICK["Find nearby songs in catalog.py<br/>rank with original score_song"]
        CHECK{"Critic checks catalog, mood path,<br/>artist repeats and explicit tracks"}
        FIX["Adjust search settings"]
        EXPLAIN["Explain each song"]
        PLAN --> PICK --> CHECK
        CHECK -- "fails and can retry" --> FIX --> PICK
        CHECK -- "passes or retries end" --> EXPLAIN
    end

    ENTRY --> VALID
    HF -.-> READER
    BASE -.-> READER
    HUMAN --> PLAN
    SCRIPT --> PLAN
    CAT -.-> PICK
    EXPLAIN --> OUT(["Playlist, reasons and critic result"])
    EXPLAIN --> TRACE[("logs/traces/<br/>agent steps and rule results")]

    subgraph EVALUATION["Evaluation"]
        CASES[("evaluation/journal_entries.csv")] --> EVAL["evaluate.py<br/>compare readers and check guards and playlists"]
        EVAL --> REPORT[("evaluation/results.md")]
    end
    EVAL -. "checks entry handling" .-> VALID
    EVAL -. "runs playlist twice" .-> PLAN

    classDef storage fill:#ecf5ed,stroke:#44805b,color:#173728
    classDef choice fill:#edf2ff,stroke:#506cad,color:#182952
    class CAT,BASE,HF,TRACE,CASES,REPORT storage
    class ENTRY,HUMAN,OUT,INVALID,HELP choice
